# Copy this file to ".env" and fill in your values (see SETUP.md part D).
# .env is git-ignored — never commit real tokens.

SPLUNK_HOST=https://your-stack.splunkcloud.com
SPLUNK_MCP_URL=https://your-stack.splunkcloud.com/services/mcp
SPLUNK_TOKEN=replace-with-your-token
SPLUNK_INDEX=main

# Local testing only: set to "false" to skip TLS verification on corporate networks.
SPLUNK_VERIFY_TLS=true

# Trust gate: autonomy requires a Wilson-confidence lower bound at/above this value (0.0–1.0)
# AND at least this many recorded runs — so one lucky success can't grant autonomy.
WARRANT_AUTONOMY_THRESHOLD=0.5
WARRANT_AUTONOMY_MIN_SAMPLES=4

# Optional Gemini diagnosis brain. Warrant still gates and verifies every action.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Phase 1 — HTTP Event Collector (telemetry ingest).
# Splunk Cloud HEC host looks like: https://http-inputs-<stack>.splunkcloud.com/services/collector/event
SPLUNK_HEC_URL=https://http-inputs-your-stack.splunkcloud.com/services/collector/event
SPLUNK_HEC_TOKEN=replace-with-your-hec-token
WARRANT_SANDBOX_URL=http://localhost:9000
WARRANT_SOURCETYPE=warrant:metrics
WARRANT_EMIT_INTERVAL_S=5
